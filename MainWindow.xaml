<Window x:Class="VideoVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoVault"
        mc:Ignorable="d"
        Title="VideoVault - 동영상 파일 관리자"
        Icon="AppIcon.ico"
        Height="1399" Width="1240"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Closing="MainWindow_Closing"
        Loaded="MainWindow_Loaded"
        SizeChanged="MainWindow_SizeChanged">
    <Window.Resources>
        <local:ThumbnailPathConverter x:Key="ThumbnailPathConverter"/>
        <local:TagsOrderConverter x:Key="TagsOrderConverter"/>
        <ContextMenu x:Key="ManagedItemContextMenu">
            <MenuItem Header="재생" Click="PlayManaged_Click"/>
            <MenuItem Header="이름변경 (F2)" Click="RenameManaged_Click"/>
            <MenuItem Header="속성 (F1)" Click="PropertiesManaged_Click"/>
            <Separator/>
            <MenuItem Header="복구" Click="RestoreManaged_Click"/>
            <MenuItem Header="삭제 (Del)" Click="RemoveFromManagedList_Click"/>
            <MenuItem Header="완전삭제" Click="PermanentlyDeleteManaged_Click"/>
        </ContextMenu>
        <DataTemplate x:Key="SizeCellTemplate">
            <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right" TextAlignment="Right"/>
        </DataTemplate>
        <DataTemplate x:Key="PlayCountCellTemplate">
            <TextBlock Text="{Binding PlayCount}" HorizontalAlignment="Center" TextAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="HasThumbnailCellTemplate">
            <Image Source="{x:Static local:WindowsIconHelper.PngFileIcon}" Width="16" Height="16" HorizontalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </DataTemplate>
        <DataTemplate x:Key="TagsCellTemplate">
            <Border Background="Transparent" Cursor="Hand" ToolTip="클릭하여 속성 열기" MouseLeftButtonUp="TagsCell_Click">
                <ItemsControl ItemsSource="{Binding Tags, Converter={StaticResource TagsOrderConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E0E0E0" CornerRadius="8" Padding="6,2" Margin="2">
                                <TextBlock Text="{Binding}" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Border DockPanel.Dock="Right" Background="{x:Static SystemColors.MenuBarBrush}">
                <TextBlock x:Name="WindowSizeText" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="Gray" FontSize="11"/>
            </Border>
            <Menu Background="{x:Static SystemColors.MenuBarBrush}">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="폴더 목록(_O)" Click="OpenFolderList_Click"/>
                <Separator/>
                <MenuItem Header="저장(_S)" InputGestureText="Ctrl+S" Click="SaveNow_Click"/>
                <MenuItem Header="관리 리스트 열기(_L)" Click="OpenManagedList_Click"/>
                <MenuItem Header="관리 리스트를 다른 이름으로 저장(_A)" Click="SaveAsManagedList_Click"/>
                <Separator/>
                <MenuItem Header="종료(_X)" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem Header="속성(_E)" Click="PropertiesManaged_Click"/>
                <MenuItem Header="이름변경(_N)" Click="RenameManaged_Click"/>
                <MenuItem Header="제거(_R)" Click="RemoveFromManagedList_Click"/>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem x:Name="ListViewModeMenuItem" Header="리스트 보기(_L)" IsCheckable="True" IsChecked="True" Click="ListViewModeMenuItem_Click"/>
                <MenuItem x:Name="IconViewModeMenuItem" Header="아이콘 보기(_I)" IsCheckable="True" Click="IconViewModeMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="재생(_P)">
                <MenuItem Header="선택 항목 재생(_P)" Click="PlayManaged_Click"/>
            </MenuItem>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="태그 관리(_T)" Click="ManageTags_Click"/>
                <MenuItem Header="배우 관리(_A)" Click="ManageActors_Click"/>
                <MenuItem Header="배우 동기화(_G)" Click="SyncActors_Click"/>
                <MenuItem Header="시리즈 관리(_S)" Click="ManageSeries_Click"/>
                <MenuItem Header="시리즈 동기화(_Y)" Click="SyncSeries_Click"/>
            </MenuItem>
            </Menu>
        </DockPanel>

        <Grid Margin="10">
        <!-- ===================== 관리 리스트 (영속 데이터, JSON, 자동 저장) ===================== -->
        <!-- 폴더 목록은 서브 창(FolderListWindow, "목록 추가" 버튼/메뉴로 열림)으로 분리됨 -->
        <Border BorderBrush="Gray" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: 파일 갯수 / 자동 저장 위치 / 안내 문구 -->
                    <RowDefinition Height="Auto"/> <!-- 1: 보기 모드 -->
                    <RowDefinition Height="Auto"/> <!-- 2: 파일 없이 추가 / 목록 추가 / 재생 -->
                    <RowDefinition Height="Auto"/> <!-- 3: 속성 / 태그 관리 / 배우 관리 / 시리즈 관리 -->
                    <RowDefinition Height="Auto"/> <!-- 4: 배우 동기화 / 시리즈 동기화 -->
                    <RowDefinition Height="Auto"/> <!-- 5: 필터 영역 -->
                    <RowDefinition Height="Auto"/> <!-- 6: 시리즈 선택 / 필터 초기화 -->
                    <RowDefinition Height="*"/>    <!-- 7: 리스트/아이콘 뷰 -->
                    <RowDefinition Height="Auto"/> <!-- 8: 선택된 항목 상세 정보 -->
                </Grid.RowDefinitions>

                <!-- 파일 갯수 + 자동 저장 위치(1번째 줄) + 안내 문구(2번째 줄) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ManagedCountText" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="    " Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="LibraryPathText" Foreground="Gray" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="(헤더를 우클릭하면 표시할 컬럼 선택, 클릭하면 정렬 / 더블클릭으로 재생 / F1=속성, F2=이름변경, Ctrl+S=저장)"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 선택된 항목의 썸네일 뷰어 (상단 오른쪽). 클릭하면 원본 이미지를 보여주고, 드래그 앤 드롭으로 썸네일을 지정할 수 있다. -->
                <StackPanel x:Name="ThumbnailPanel" Grid.Row="0" Grid.RowSpan="7" Grid.Column="1"
                            Width="320" Margin="15,0,0,0" VerticalAlignment="Top">
                    <Border Width="320" Height="240" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="1" Cursor="Hand"
                            ToolTip="클릭: 원본 이미지 보기 / 드래그 앤 드롭: 썸네일 지정"
                            AllowDrop="True" Drop="ThumbnailViewer_Drop" DragOver="ThumbnailViewer_DragOver"
                            MouseLeftButtonUp="ThumbnailViewer_MouseLeftButtonUp">
                        <Grid>
                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailPathConverter}}" Stretch="Uniform">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="🎬" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 저장/열기/다른 이름으로 저장 버튼은 삭제되었지만 기능은 유지된다 (파일 메뉴 + Ctrl+S) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="ListViewModeRadio" Content="리스트 보기" GroupName="ViewMode" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ViewMode_Changed"/>
                    <RadioButton x:Name="IconViewModeRadio" Content="아이콘 보기" GroupName="ViewMode" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ViewMode_Changed"/>
                    <ComboBox x:Name="IconSizeComboBox" Width="110" Margin="0,0,15,0" SelectedIndex="2" SelectionChanged="IconSizeComboBox_SelectionChanged">
                        <ComboBoxItem Content="아주 큰 아이콘"/>
                        <ComboBoxItem Content="큰 아이콘"/>
                        <ComboBoxItem Content="보통 아이콘"/>
                        <ComboBoxItem Content="작은 아이콘"/>
                    </ComboBox>
                    <CheckBox x:Name="ShowRemovedItemsCheckBox" Content="제거된 항목도 표시" VerticalAlignment="Center" Margin="0,0,15,0" Checked="ShowRemovedItemsCheckBox_Changed" Unchecked="ShowRemovedItemsCheckBox_Changed"/>
                    <CheckBox x:Name="IconOnlyModeCheckBox" Content="아이콘만 보기" VerticalAlignment="Center" ToolTip="아이콘 보기에서 썸네일만 보여주고 카드 크기를 썸네일 크기에 맞게 줄인다." Checked="IconOnlyModeCheckBox_Changed" Unchecked="IconOnlyModeCheckBox_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="파일 없이 추가 (Ctrl+N)" Padding="10,5" Margin="0,0,5,0" Click="AddPlaceholderItem_Click"/>
                    <Button Content="목록 추가" Padding="10,5" Margin="0,0,5,0" Click="OpenFolderList_Click"/>
                    <Button Content="재생" Padding="10,5" Click="PlayManaged_Click"/>
                </StackPanel>

                <!-- 이름변경/제거 버튼은 삭제되었지만 F2/Del 단축키와 우클릭 메뉴, 편집 메뉴로 기능은 유지된다 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="속성 (F1)" Padding="10,5" Margin="0,0,5,0" Click="PropertiesManaged_Click"/>
                    <Button Content="태그 관리" Padding="10,5" Margin="0,0,5,0" Click="ManageTags_Click"/>
                    <Button Content="배우 관리" Padding="10,5" Margin="0,0,5,0" Click="ManageActors_Click"/>
                    <Button Content="시리즈 관리" Padding="10,5" Click="ManageSeries_Click"/>
                </StackPanel>

                <!-- 배우/시리즈 동기화: "속성" 버튼 밑에 배치(2026-08-10 위치 변경 — 예전에는 위 줄 배우 관리/시리즈 관리 옆에 있었음) -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="배우 동기화" Padding="10,5" Margin="0,0,5,0" Click="SyncActors_Click" ToolTip="각 배우의 품번(Credits) 목록을 기준으로, 아직 그 배우가 지정되지 않은 관리 리스트 항목에 배우를 추가한다."/>
                    <Button Content="시리즈 동기화" Padding="10,5" Margin="0,0,15,0" Click="SyncSeries_Click" ToolTip="각 시리즈의 품번(Credits) 목록을 기준으로, 시리즈가 아직 비어있는 관리 리스트 항목에 해당 시리즈를 채워 넣는다."/>
                    <Button Content="선택한 파일 이동" Padding="10,5" Click="MoveSelectedFiles_Click" ToolTip="선택한 각 항목을, 그 항목의 '코드' 값으로 된 하위 폴더(현재 폴더와 같은 위치)로 이동한다. 속성 창의 '파일 이동' 버튼과 동일한 동작을 여러 항목에 한 번에 적용한다."/>
                </StackPanel>

                <!-- 검색(필터) 영역: 파일명 검색 + 폴더명 검색 + 태그/배우 필터 -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="파일명 검색:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="NameFilterTextBox" Width="80" Margin="0,0,15,0" TextChanged="NameFilterTextBox_TextChanged"/>
                    <TextBlock Text="폴더명 검색:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="FolderFilterTextBox" Width="80" Margin="0,0,15,0" TextChanged="FolderFilterTextBox_TextChanged"/>
                    <Button x:Name="TagFilterButton" Content="태그 필터" Padding="10,5" Margin="0,0,5,0" Click="TagFilterButton_Click"/>
                    <Button x:Name="ActorFilterButton" Content="배우 필터" Padding="10,5" Click="ActorFilterButton_Click"/>
                </StackPanel>

                <!-- 시리즈 선택 + 필터 초기화(2026-08-16 필터 영역에서 한 줄 아래로 분리, 필터 초기화를 옆으로 이동) -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="시리즈 선택:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="SeriesFilterComboBox" Width="240" Margin="0,0,15,0" SelectionChanged="SeriesFilterComboBox_SelectionChanged"/>
                    <Button Content="필터 초기화" Padding="10,5" Click="ClearAllFilters_Click"/>
                </StackPanel>

                <Grid Grid.Row="7" Grid.ColumnSpan="2"
                      AllowDrop="True" DragEnter="ManagedList_DragEnter" Drop="ManagedList_Drop">
                    <ListView x:Name="ManagedListView" SelectionMode="Extended" SelectionChanged="ManagedSelection_Changed"
                              TextSearch.TextPath="FileName">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ManagedListItem_PreviewMouseRightButtonDown"/>
                                <EventSetter Event="MouseDoubleClick" Handler="ManagedListRow_MouseDoubleClick"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ManagedItem_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="PreviewMouseMove" Handler="ManagedItem_PreviewMouseMove"/>
                                <Setter Property="ContextMenu" Value="{StaticResource ManagedItemContextMenu}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsValid}" Value="True"/>
                                            <Condition Binding="{Binding IsExist}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="FileNameColumn" Header="파일명" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" ToolTip="더블클릭하여 재생"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ListBox x:Name="ManagedIconView" Visibility="Collapsed" SelectionMode="Extended" SelectionChanged="ManagedSelection_Changed"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True" MouseRightButtonUp="ManagedIconView_MouseRightButtonUp"
                              TextSearch.TextPath="ProductCode">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ManagedIconItem_PreviewMouseRightButtonDown"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ManagedItem_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="PreviewMouseMove" Handler="ManagedItem_PreviewMouseMove"/>
                                <Setter Property="ContextMenu" Value="{StaticResource ManagedItemContextMenu}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsValid}" Value="True"/>
                                            <Condition Binding="{Binding IsExist}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:VirtualizingWrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=CardWidth}"
                                        Height="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=CardHeight}"
                                        Margin="5" BorderBrush="LightGray" BorderThickness="1" Padding="5"
                                        MouseEnter="IconCard_MouseEnter" MouseLeave="IconCard_MouseLeave">
                                    <StackPanel>
                                        <Border Width="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=ThumbnailWidth}"
                                                Height="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=ThumbnailHeight}"
                                                Background="#F0F0F0">
                                            <Grid>
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailPathConverter}, ConverterParameter=240}" Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="🎬" FontSize="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=FallbackIconFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Background="#B0000000" VerticalAlignment="Bottom" Padding="4,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=IconOnly}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ProductCode}" Foreground="White" FontWeight="Bold" TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=FileNameFontSize}"
                                                               ToolTip="더블클릭하여 재생" MouseLeftButtonDown="FileNameCell_MouseLeftButtonDown"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding ProductCode}" TextWrapping="Wrap" TextAlignment="Center"
                                                   FontSize="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=FileNameFontSize}" Margin="0,5,0,0"
                                                   ToolTip="더블클릭하여 재생" MouseLeftButtonDown="FileNameCell_MouseLeftButtonDown">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=IconOnly}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SizeDisplay}"
                                                   FontSize="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=PlayCountFontSize}" Foreground="Gray" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=ShowSize}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=IconOnly}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PlayCount, StringFormat='재생 {0}회'}"
                                                   FontSize="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=PlayCountFontSize}" Foreground="Gray" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=ShowPlayCount}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=IconOnly}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#E0E0E0" CornerRadius="6" Padding="4,1" Margin="1">
                                                        <TextBlock Text="{Binding}" FontSize="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=TagFontSize}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=ShowTags}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=IconOnly}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Series}" TextWrapping="Wrap" TextAlignment="Center"
                                                   FontSize="{Binding Source={x:Static local:IconSizeSettings.Current}, Path=TagFontSize}" Foreground="Gray" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=ShowSeries}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=IconOnly}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- "아이콘만 보기"에서 카드 텍스트 정보가 모두 숨겨지므로, 카드에 마우스를 올리면 대신 보여주는 파일 정보 팝업 -->
                    <Popup x:Name="IconOnlyInfoPopup" Placement="Mouse" HorizontalOffset="12" VerticalOffset="12"
                           AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="False">
                        <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
                            <StackPanel MaxWidth="220">
                                <TextBlock Text="{Binding ProductCode}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding SizeDisplay}" Foreground="Gray" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=ShowSize}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding PlayCount, StringFormat='재생 {0}회'}" Foreground="Gray" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=ShowPlayCount}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E0E0E0" CornerRadius="6" Padding="4,1" Margin="1">
                                                <TextBlock Text="{Binding}" FontSize="10"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=ShowTags}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                                <TextBlock Text="{Binding Series}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Gray" HorizontalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static local:IconCardFieldsSettings.Current}, Path=ShowSeries}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 태그 필터 팝업 (태그 마스터 목록 기준, "태그 필터" 버튼으로 열림) -->
                    <Popup x:Name="TagFilterPopup" StaysOpen="False" Placement="Bottom">
                        <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="10">
                            <StackPanel Width="220">
                                <TextBlock Text="태그 필터" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="TagFilterList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Tag}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="초기화" Padding="8,3" Margin="0,0,5,0" Click="TagFilterClear_Click"/>
                                    <Button Content="적용" Padding="8,3" Click="TagFilterApply_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 배우 필터 팝업 (배우 마스터 목록 기준, "배우 필터" 버튼으로 열림, 여러 명 선택 가능) -->
                    <Popup x:Name="ActorFilterPopup" StaysOpen="False" Placement="Bottom">
                        <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="10">
                            <StackPanel Width="220">
                                <TextBlock Text="배우 필터" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ActorFilterList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding ActorName}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="초기화" Padding="8,3" Margin="0,0,5,0" Click="ActorFilterClear_Click"/>
                                    <Button Content="적용" Padding="8,3" Click="ActorFilterApply_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 헤더 우클릭: 표시할 컬럼 선택 팝업 -->
                    <Popup x:Name="ColumnChooserPopup" StaysOpen="False" Placement="Bottom">
                        <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="10">
                            <StackPanel Width="160">
                                <TextBlock Text="표시할 컬럼" FontWeight="Bold" Margin="0,0,0,5"/>
                                <CheckBox x:Name="ThumbnailColumnCheckBox" Content="썸네일 (맨 앞)" IsChecked="False" Margin="0,2" Click="ColumnToggle_Click" Tag="Thumbnail"/>
                                <CheckBox x:Name="SizeColumnCheckBox" Content="크기" IsChecked="True" Margin="0,2" Click="ColumnToggle_Click" Tag="Size"/>
                                <CheckBox x:Name="PlayCountColumnCheckBox" Content="재생횟수" IsChecked="True" Margin="0,2" Click="ColumnToggle_Click" Tag="PlayCount"/>
                                <CheckBox x:Name="TagsColumnCheckBox" Content="태그" IsChecked="True" Margin="0,2" Click="ColumnToggle_Click" Tag="Tags"/>
                                <CheckBox x:Name="ActorColumnCheckBox" Content="배우" IsChecked="False" Margin="0,2" Click="ColumnToggle_Click" Tag="Actor"/>
                                <CheckBox x:Name="MemoColumnCheckBox" Content="메모" IsChecked="False" Margin="0,2" Click="ColumnToggle_Click" Tag="Memo"/>
                                <CheckBox x:Name="FolderColumnCheckBox" Content="폴더명" IsChecked="False" Margin="0,2" Click="ColumnToggle_Click" Tag="Folder"/>
                                <CheckBox x:Name="CodeColumnCheckBox" Content="코드" IsChecked="False" Margin="0,2" Click="ColumnToggle_Click" Tag="Code"/>
                                <CheckBox x:Name="SeriesColumnCheckBox" Content="시리즈" IsChecked="False" Margin="0,2" Click="ColumnToggle_Click" Tag="Series"/>
                                <CheckBox x:Name="ReleaseDateColumnCheckBox" Content="출시일" IsChecked="False" Margin="0,2" Click="ColumnToggle_Click" Tag="ReleaseDate"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 아이콘 보기 빈 공간 우클릭: 카드에 표시할 정보 선택 팝업 -->
                    <Popup x:Name="IconInfoChooserPopup" StaysOpen="False" Placement="MousePoint">
                        <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="10">
                            <StackPanel Width="140">
                                <TextBlock Text="표시할 정보" FontWeight="Bold" Margin="0,0,0,5"/>
                                <CheckBox x:Name="IconSizeFieldCheckBox" Content="크기" IsChecked="False" Margin="0,2" Click="IconFieldToggle_Click" Tag="Size"/>
                                <CheckBox x:Name="IconPlayCountFieldCheckBox" Content="재생횟수" IsChecked="True" Margin="0,2" Click="IconFieldToggle_Click" Tag="PlayCount"/>
                                <CheckBox x:Name="IconTagsFieldCheckBox" Content="태그" IsChecked="True" Margin="0,2" Click="IconFieldToggle_Click" Tag="Tags"/>
                                <CheckBox x:Name="IconSeriesFieldCheckBox" Content="시리즈" IsChecked="False" Margin="0,2" Click="IconFieldToggle_Click" Tag="Series"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 선택된 항목의 상세 정보 -->
                <Border Grid.Row="8" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,10,0,0" MinHeight="90">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NoSelectionHint" Grid.Column="0" Text="선택된 항목이 없습니다." Foreground="Gray" VerticalAlignment="Center"/>
                        <StackPanel x:Name="SelectedItemDetailsPanel" Grid.Column="0" Visibility="Collapsed">
                            <TextBlock FontWeight="Bold" FontSize="13" Text="{Binding FileName}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <TextBlock Text="{Binding SizeDisplay, StringFormat='크기: {0}   '}"/>
                                <TextBlock Text="{Binding ModifiedDate, StringFormat='수정일: {0:yyyy-MM-dd HH:mm}   '}"/>
                                <TextBlock Text="{Binding PlayCount, StringFormat='재생횟수: {0}   '}"/>
                                <TextBlock Text="{Binding ActorsDisplay, StringFormat='배우: {0}   '}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Memo, StringFormat='메모: {0}'}" TextWrapping="Wrap" MaxHeight="34" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding FullPath, StringFormat='경로: {0}'}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,4"/>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#E0E0E0" CornerRadius="8" Padding="6,2" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 선택된 항목의 배우 썸네일들 (100x100, 여러 명이면 오른쪽 정렬로 차례대로 표시) -->
                        <ItemsControl x:Name="SelectedItemActorsPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="100" Height="100" Margin="4,0,0,0" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="1" ToolTip="{Binding Name}">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailPathConverter}}" Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
</Window>
