<Window x:Class="VideoVault.SeriesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoVault"
        mc:Ignorable="d"
        Title="시리즈 관리" Height="700" Width="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Credits 칩: 배우 관리 창의 Credits 칩과 같은 모양(둥근 배경, 패딩)에 관리 리스트 보유 여부에 따라 색만 다르게 -->
        <Style x:Key="CreditChipBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="#CFE2F3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="클릭하여 속성 열기 / 우클릭하여 Credits에서 삭제"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFile}" Value="True">
                    <Setter Property="Background" Value="#3D6FB4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CreditChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1B3A5C"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFile}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/> <!-- 0: 시리즈 리스트 (10줄) -->
            <RowDefinition Height="Auto"/> <!-- 1: 시리즈 입력 + 추가/변경/삭제 -->
            <RowDefinition Height="Auto"/> <!-- 2: 품번 헤더 + 추가 -->
            <RowDefinition Height="*"/>    <!-- 3: 품번 목록 -->
            <RowDefinition Height="Auto"/> <!-- 4: 상태바 -->
        </Grid.RowDefinitions>

        <ListView x:Name="SeriesListBox" Grid.Row="0" Margin="0,0,0,10"
                 SelectionChanged="SeriesListBox_SelectionChanged" SizeChanged="SeriesListBox_SizeChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="SeriesNameColumn" Header="시리즈 이름" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn x:Name="CreditCountColumn" Header="작품수" DisplayMemberBinding="{Binding Credits.Count}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="SeriesBox" Width="180" Margin="0,0,5,0"/>
            <Button Content="추가" Padding="8,3" Margin="0,0,5,0" Click="AddSeries_Click"/>
            <Button Content="변경" Padding="8,3" Margin="0,0,5,0" Click="RenameSeries_Click"/>
            <Button Content="삭제" Padding="8,3" Click="DeleteSeries_Click"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="품번" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="추가" Padding="6,2" Click="AddCredit_Click"/>
        </Grid>

        <Border Grid.Row="3" CornerRadius="8" BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6"
                          AllowDrop="True" DragOver="CreditsList_DragOver" Drop="CreditsList_Drop">
                <ItemsControl x:Name="CreditsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CreditChipBorderStyle}" Tag="{Binding Code}"
                                    MouseLeftButtonUp="CreditChip_MouseLeftButtonUp" MouseRightButtonUp="CreditChip_MouseRightButtonUp"
                                    MouseEnter="CreditChip_MouseEnter" MouseLeave="CreditChip_MouseLeave">
                                <TextBlock Text="{Binding Code}" Style="{StaticResource CreditChipTextStyle}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 품번 칩에 마우스를 올리면 뜨는 썸네일 미리보기 팝업(2026-08-16 추가) — 큰 아이콘 보기 썸네일 크기(180x131)와 동일 -->
        <Popup x:Name="CreditThumbnailPopup" Placement="Mouse" HorizontalOffset="12" VerticalOffset="12"
               AllowsTransparency="True" IsHitTestVisible="False" StaysOpen="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="2">
                <Image x:Name="CreditThumbnailImage" Width="180" Height="131" Stretch="Uniform"/>
            </Border>
        </Popup>

        <!-- 상태바(2026-08-29 추가, 2026-08-29 스타일 개선) — 중복 품번 등 단순 안내 메시지와 성공 이벤트를
             대화상자 대신 여기 표시한다. 종류(성공/경고/정보/오류)에 따라 아이콘과 글자색이 달라진다
             (코드에서 SetStatus가 색/아이콘을 함께 지정, 아래 참고). -->
        <Border Grid.Row="4" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA" Padding="10,6" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusIcon" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
