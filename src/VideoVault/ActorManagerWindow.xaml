<Window x:Class="VideoVault.ActorManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoVault"
        mc:Ignorable="d"
        Title="배우 관리" Height="1000" Width="1000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <local:ThumbnailPathConverter x:Key="ThumbnailPathConverter"/>
        <ContextMenu x:Key="ActorItemContextMenu">
            <MenuItem Header="배우 정보 수정" Click="EditActorInfo_Click"/>
        </ContextMenu>
        <!-- Credits 칩: 태그 칩과 같은 모양(둥근 배경, 패딩)에 관리 리스트 보유 여부에 따라 색만 다르게 -->
        <Style x:Key="CreditChipBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="#CFE2F3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="클릭하여 속성 열기 / 우클릭하여 Credits에서 삭제"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFile}" Value="True">
                    <Setter Property="Background" Value="#3D6FB4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CreditChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1B3A5C"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFile}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="RightPanelColumn" Width="220" MinWidth="150" MaxWidth="600"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 썸네일/작품 리스트 창(오른쪽 패널)의 가로 크기를 조절하는 스플리터(2026-08-27 추가, 사용자 요청). -->
        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#DDDDDD" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

        <!-- 아이콘 보기: 배우 이름과 썸네일만 보여준다 -->
        <ListBox x:Name="ActorsListBox" Grid.Row="0" Grid.Column="0" Margin="0,0,0,10"
                  SelectionChanged="ActorsListBox_SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ActorListItem_PreviewMouseRightButtonDown"/>
                    <Setter Property="ContextMenu" Value="{StaticResource ActorItemContextMenu}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="110" Height="155" Margin="5" BorderBrush="LightGray" BorderThickness="1" Padding="5">
                        <StackPanel>
                            <Border Width="90" Height="90" Background="#F0F0F0" HorizontalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailPathConverter}}" Stretch="UniformToFill">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Credits.Count}" TextAlignment="Center" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="ActorBox" Width="180" Margin="0,0,5,0"/>
            <Button Content="추가" Padding="8,3" Margin="0,0,5,0" Click="Add_Click"/>
            <Button Content="변경" Padding="8,3" Margin="0,0,5,0" Click="Rename_Click"/>
            <Button Content="삭제" Padding="8,3" Click="Delete_Click"/>
        </StackPanel>

        <!-- 오른쪽: 선택된 배우의 썸네일(원본은 별도로 보관하지 않음) + 품번(Credits) 리스트. 썸네일 블록은
             내용에 맞는 높이(Auto)만 차지하고, 품번 리스트는 남는 세로 공간을 전부 채운다(2026-08-27 변경,
             사용자 요청 — "작품 리스트를 현재 창 기준으로 세로 크기를 최대로"). 가로 크기는 왼쪽의
             GridSplitter로 오른쪽 패널(이 Grid.Column="2") 전체 폭을 조절할 수 있다. 왼쪽 여백(Margin의 첫 값)은
             오른쪽 창 테두리 여백(바깥 Grid의 Margin="10")과 맞춰 10으로 뒀다(2026-08-27 추가, 사용자 요청 —
             스플리터 자체는 여백 대상이 아니므로 스플리터와 오른쪽 패널 사이에만 이 여백이 들어간다). -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="썸네일" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="ThumbnailPathText" Text="지정된 썸네일 없음" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="썸네일 추가" Padding="8,3" Margin="0,0,5,0" Click="AddThumbnailButton_Click"/>
                    <Button Content="썸네일 삭제" Padding="8,3" Click="DeleteThumbnailButton_Click"/>
                </StackPanel>
                <Border MinWidth="100" MinHeight="100" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#F0F0F0" BorderBrush="Gray" BorderThickness="1"
                        ToolTip="드래그 앤 드롭으로 썸네일 지정"
                        AllowDrop="True" Drop="ThumbnailViewer_Drop" DragOver="ThumbnailViewer_DragOver">
                    <Grid>
                        <Image x:Name="ThumbnailImage" Stretch="None" Visibility="Collapsed"/>
                        <TextBlock x:Name="ThumbnailFallbackIcon" Text="👤" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 썸네일 정보 밑에 선택된 배우의 정보 표시 (우클릭 메뉴 "배우 정보 수정"으로 편집) -->
                <TextBlock Text="배우 정보" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBlock x:Name="ActorNameInfoText" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock x:Name="ActorBirthYearInfoText" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock x:Name="ActorHeightInfoText" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock x:Name="ActorBodyInfoText" TextWrapping="Wrap" Margin="0,0,0,3"/>

                <!-- 배우 정보 밑에 이 배우가 출연한 것으로 등록된 품번(Credits) 헤더. 목록 자체(진한 파란색=관리
                     리스트에 실제 파일 있음)는 아래 Grid.Row="1"에서 남는 공간을 전부 채운다. -->
                <Grid Margin="0,15,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="품번" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="작품 추가" Padding="6,2" Click="AddCredit_Click"/>
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="8" BorderBrush="Gray" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6"
                              AllowDrop="True" DragOver="CreditsList_DragOver" Drop="CreditsList_Drop">
                    <ItemsControl x:Name="CreditsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CreditChipBorderStyle}" Tag="{Binding Code}"
                                        MouseLeftButtonUp="CreditChip_MouseLeftButtonUp" MouseRightButtonUp="CreditChip_MouseRightButtonUp"
                                        MouseEnter="CreditChip_MouseEnter" MouseLeave="CreditChip_MouseLeave">
                                    <TextBlock Text="{Binding Code}" Style="{StaticResource CreditChipTextStyle}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 품번 칩에 마우스를 올리면 뜨는 썸네일 미리보기 팝업(2026-08-16 추가) — 큰 아이콘 보기 썸네일 크기(180x131)와 동일 -->
        <Popup x:Name="CreditThumbnailPopup" Placement="Mouse" HorizontalOffset="12" VerticalOffset="12"
               AllowsTransparency="True" IsHitTestVisible="False" StaysOpen="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="2">
                <Image x:Name="CreditThumbnailImage" Width="180" Height="131" Stretch="Uniform"/>
            </Border>
        </Popup>

        <!-- 상태바(2026-08-29 추가, 2026-08-29 스타일 개선) — 중복 품번 등 단순 안내 메시지와 성공 이벤트를
             대화상자 대신 여기 표시한다. 종류(성공/경고/정보/오류)에 따라 아이콘과 글자색이 달라진다
             (코드에서 SetStatus가 색/아이콘을 함께 지정, 아래 참고). -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1"
                Background="#FAFAFA" Padding="10,6" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusIcon" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
