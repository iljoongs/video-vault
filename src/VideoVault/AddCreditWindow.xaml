<Window x:Class="VideoVault.AddCreditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoVault"
        mc:Ignorable="d"
        Title="작품 추가" Height="520" Width="420"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:ThumbnailPathConverter x:Key="ThumbnailPathConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="품번:" Margin="0,0,0,5"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CodeBox" Grid.Column="0" Margin="0,0,5,0" TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown"/>
            <Button Grid.Column="1" Content="추가" Padding="10,3" Click="AddButton_Click"/>
        </Grid>

        <!-- 입력한 품번으로 관리 리스트를 미리보기 식으로 검색해서 보여준다. 목록에 없는 값도 그대로 입력 가능하다. -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="NoMatchHint"
                       Text="일치하는 관리 리스트 항목이 없습니다.&#10;(그래도 입력한 값 그대로 추가할 수 있습니다)"
                       Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyQueryHint" Text="품번을 입력하면 관리 리스트에서 일치하는 항목을 미리 보여줍니다."
                       Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
            <ListBox x:Name="PreviewList" MouseDoubleClick="PreviewList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2" ToolTip="더블클릭하면 품번 입력란에 채워집니다">
                            <Border Width="60" Height="45" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailPathConverter}}" Stretch="UniformToFill">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="🎬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Code}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="닫기" Width="80" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
