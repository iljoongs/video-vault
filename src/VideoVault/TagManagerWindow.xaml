<Window x:Class="VideoVault.TagManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="태그 관리" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="TagsListBox" Grid.Row="0" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBox x:Name="TagBox" Width="180" Margin="0,0,5,0"/>
            <Button Content="추가" Padding="8,3" Margin="0,0,5,0" Click="Add_Click"/>
            <Button Content="변경" Padding="8,3" Margin="0,0,5,0" Click="Rename_Click"/>
            <Button Content="삭제" Padding="8,3" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>
