<Window x:Class="VideoVault.SeriesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoVault"
        mc:Ignorable="d"
        Title="시리즈 관리" Height="700" Width="450"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Credits 칩: 배우 관리 창의 Credits 칩과 같은 모양(둥근 배경, 패딩)에 관리 리스트 보유 여부에 따라 색만 다르게 -->
        <Style x:Key="CreditChipBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="#CFE2F3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="클릭하여 속성 열기 / 우클릭하여 Credits에서 삭제"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFile}" Value="True">
                    <Setter Property="Background" Value="#3D6FB4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CreditChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1B3A5C"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFile}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/> <!-- 0: 시리즈 리스트 (10줄) -->
            <RowDefinition Height="Auto"/> <!-- 1: 시리즈 이름 입력 + 추가 -->
            <RowDefinition Height="Auto"/> <!-- 2: 시리즈 삭제 + 작품 추가 -->
            <RowDefinition Height="Auto"/> <!-- 3: 품번 헤더 -->
            <RowDefinition Height="*"/>    <!-- 4: 품번 목록 -->
            <RowDefinition Height="Auto"/> <!-- 5: 닫기 -->
        </Grid.RowDefinitions>

        <ListView x:Name="SeriesListBox" Grid.Row="0" Margin="0,0,0,10"
                 SelectionChanged="SeriesListBox_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="시리즈 이름" Width="270" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="작품수" Width="80" DisplayMemberBinding="{Binding Credits.Count}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="NewSeriesBox" Width="220" Margin="0,0,5,0"/>
            <Button Content="시리즈 추가" Padding="10,3" Margin="0,0,5,0" Click="AddSeries_Click"/>
            <Button Content="시리즈 삭제" Padding="8,3" Click="DeleteSeries_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="작품 추가" Padding="8,3" Click="AddCredit_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="품번" FontWeight="Bold" Margin="0,0,0,5"/>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                      AllowDrop="True" DragOver="CreditsList_DragOver" Drop="CreditsList_Drop">
            <ItemsControl x:Name="CreditsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CreditChipBorderStyle}" Tag="{Binding Code}"
                                MouseLeftButtonUp="CreditChip_MouseLeftButtonUp" MouseRightButtonUp="CreditChip_MouseRightButtonUp"
                                MouseEnter="CreditChip_MouseEnter" MouseLeave="CreditChip_MouseLeave">
                            <TextBlock Text="{Binding Code}" Style="{StaticResource CreditChipTextStyle}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 품번 칩에 마우스를 올리면 뜨는 썸네일 미리보기 팝업(2026-08-16 추가) — 큰 아이콘 보기 썸네일 크기(180x131)와 동일 -->
        <Popup x:Name="CreditThumbnailPopup" Placement="Mouse" HorizontalOffset="12" VerticalOffset="12"
               AllowsTransparency="True" IsHitTestVisible="False" StaysOpen="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="2">
                <Image x:Name="CreditThumbnailImage" Width="180" Height="131" Stretch="Uniform"/>
            </Border>
        </Popup>

        <Button Grid.Row="5" Content="닫기" Width="80" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
