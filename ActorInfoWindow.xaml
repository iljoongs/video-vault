<Window x:Class="VideoVault.ActorInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="배우 정보" Height="290" Width="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="이름:" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Width="260"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="출생년도:" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="BirthYearBox" Width="260"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="키(cm):" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="HeightBox" Width="260"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="신체정보:" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="BodyInfoBox" Width="260"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="출생년도/키/신체정보는 비워두면 삭제됩니다." Foreground="Gray" FontSize="11" VerticalAlignment="Top" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="확인" Width="80" Margin="0,0,5,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="취소" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
